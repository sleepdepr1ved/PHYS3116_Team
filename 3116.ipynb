   "source": [
    "# Identify outliers based on residuals\n",
    "threshold = 1.15 * residuals.std()\n",
    "outliers = merged_data[abs(residuals) > threshold]\n",
    "\n",
    "print(\"Number of outliers:\", len(outliers))\n",
    "print(outliers[['Object', 'Y', 'v_r', 'FeH']])"
   ]
